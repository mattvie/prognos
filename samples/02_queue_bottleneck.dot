digraph SPN {
  rankdir=LR;
  splines=spline;
  nodesep=0.75;
  ranksep=1.05;
  bgcolor="white";
  pad=0.35;
  forcelabels=true;
  compound=true;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.75, color="#2b2b2b"];

  // --- RECURSOS COMPARTILHADOS ---
  P_Workers [shape=circle, style=filled, fillcolor="#e8f0fe", color="#33507a", penwidth=1.6, width=0.55, fixedsize=true, label="1", xlabel="P_Workers"];

  // --- SUBREDES DAS ROTAS ---
  subgraph cluster_GET_export {
    label="GET_export";
    fontsize=12;
    style=rounded; color="#b9c4d4"; margin=14;
    P_Gen_GET_export [shape=circle, style=filled, fillcolor="#e8f0fe", color="#33507a", penwidth=1.6, width=0.55, fixedsize=true, label="", xlabel="P_Gen"];
    P_Queue_GET_export [shape=circle, style=filled, fillcolor="#e8f0fe", color="#33507a", penwidth=1.6, width=0.55, fixedsize=true, label="", xlabel="P_Queue"];
    P_Busy_GET_export [shape=circle, style=filled, fillcolor="#e8f0fe", color="#33507a", penwidth=1.6, width=0.55, fixedsize=true, label="", xlabel="P_Busy"];
    P_Free_GET_export [shape=circle, style=filled, fillcolor="#e8f0fe", color="#33507a", penwidth=1.6, width=0.55, fixedsize=true, label="3", xlabel="P_Free"];
    TT_Arrival_GET_export [shape=box, style=filled, fillcolor="white", color="#3c3c3c", penwidth=1.8, width=0.17, height=0.55, fixedsize=true, label="", xlabel="TT_Arrival"];
    IT_Enter_GET_export [shape=box, style=filled, fillcolor="#3c3c3c", color="#3c3c3c", width=0.13, height=0.55, fixedsize=true, label="", xlabel="IT_Enter"];
    IT_Start_GET_export [shape=box, style=filled, fillcolor="#3c3c3c", color="#3c3c3c", width=0.13, height=0.55, fixedsize=true, label="", xlabel="IT_Start"];
    TT_Processing_GET_export [shape=box, style=filled, fillcolor="white", color="#3c3c3c", penwidth=1.8, width=0.17, height=0.55, fixedsize=true, label="", xlabel="TT_Processing"];
    IT_Drop_GET_export [shape=box, style=filled, fillcolor="#3c3c3c", color="#3c3c3c", width=0.13, height=0.55, fixedsize=true, label="", xlabel="IT_Drop"];
  }

  // --- ARCOS ---
  TT_Arrival_GET_export -> P_Gen_GET_export;
  P_Gen_GET_export -> IT_Enter_GET_export;
  P_Free_GET_export -> IT_Enter_GET_export [color="#8a5a00"];
  IT_Enter_GET_export -> P_Queue_GET_export;
  P_Queue_GET_export -> IT_Start_GET_export;
  P_Workers -> IT_Start_GET_export [color="#1a6b3c"];
  IT_Start_GET_export -> P_Busy_GET_export;
  P_Busy_GET_export -> TT_Processing_GET_export;
  TT_Processing_GET_export -> P_Workers [color="#1a6b3c", constraint=false];
  TT_Processing_GET_export -> P_Free_GET_export [color="#8a5a00", constraint=false];
  P_Gen_GET_export -> IT_Drop_GET_export;
  P_Free_GET_export -> IT_Drop_GET_export [arrowhead=odot, color="#b03030", penwidth=1.7, constraint=false];
}
